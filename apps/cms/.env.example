# Neon Postgres connection string (self-hosted Payload backend on Render)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string, used to sign Payload's JWTs/cookies
PAYLOAD_SECRET=

# Frontend origin allowed to call this API via CORS (apps/web)
WEB_APP_URL=http://localhost:3001

# Cloudflare R2 (media storage) — bucket name, S3-compatible API credentials,
# the account-scoped endpoint, and the bucket's public r2.dev (or custom) domain
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
